{
  "title": "logpipe pipeline",
  "layout_type": "ordered",
  "description": "logpipe at a glance: what it parsed and caught, what it calls (Service Map), and time and errors per stage. Vertical markers are logpipe's incident and RCA events.",
  "widgets": [
    {
      "definition": {
        "type": "query_value",
        "title": "Lines parsed",
        "autoscale": true,
        "precision": 0,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "metrics",
                "name": "q",
                "query": "sum:logpipe.lines{*}.as_count()",
                "aggregator": "sum"
              }
            ],
            "formulas": [
              {
                "formula": "q"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Anomalies",
        "autoscale": true,
        "precision": 0,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "metrics",
                "name": "q",
                "query": "sum:logpipe.anomalies{*}.as_count()",
                "aggregator": "sum"
              }
            ],
            "formulas": [
              {
                "formula": "q"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "type": "query_value",
        "title": "Stage errors",
        "autoscale": true,
        "precision": 0,
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "data_source": "metrics",
                "name": "q",
                "query": "sum:logpipe.stage.errors{*}.as_count()",
                "aggregator": "sum"
              }
            ],
            "formulas": [
              {
                "formula": "q"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "type": "topology_map",
        "title": "What logpipe calls (APM, DD_APM=1)",
        "requests": [
          {
            "request_type": "topology",
            "query": {
              "data_source": "service_map",
              "service": "logpipe",
              "filters": [
                "env:*"
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Requests and errors (APM)",
        "requests": [
          {
            "q": "sum:trace.fastapi.request.hits{service:logpipe}.as_count()",
            "display_type": "bars"
          },
          {
            "q": "sum:trace.fastapi.request.errors{service:logpipe}.as_count()",
            "display_type": "bars",
            "style": {
              "palette": "warm"
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Stage duration p99 (ms)",
        "requests": [
          {
            "q": "p99:logpipe.stage.duration{*} by {stage}",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Stage duration avg (ms)",
        "requests": [
          {
            "q": "avg:logpipe.stage.duration{*} by {stage}",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Stage errors",
        "requests": [
          {
            "q": "sum:logpipe.stage.errors{*} by {stage}.as_count()",
            "display_type": "bars"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Lines by status",
        "requests": [
          {
            "display_type": "bars",
            "response_format": "timeseries",
            "queries": [
              {
                "data_source": "metrics",
                "name": "m",
                "query": "sum:logpipe.lines{*} by {status}.as_count()"
              }
            ],
            "formulas": [
              {
                "formula": "m"
              }
            ]
          },
          {
            "display_type": "overlay",
            "response_format": "timeseries",
            "on_right_yaxis": false,
            "queries": [
              {
                "data_source": "events",
                "name": "ev",
                "search": {
                  "query": "logpipe_incident:*"
                },
                "compute": {
                  "aggregation": "count"
                }
              }
            ],
            "formulas": [
              {
                "formula": "ev"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Anomalies",
        "requests": [
          {
            "display_type": "bars",
            "response_format": "timeseries",
            "queries": [
              {
                "data_source": "metrics",
                "name": "m",
                "query": "sum:logpipe.anomalies{*}.as_count()"
              }
            ],
            "formulas": [
              {
                "formula": "m"
              }
            ]
          },
          {
            "display_type": "overlay",
            "response_format": "timeseries",
            "on_right_yaxis": false,
            "queries": [
              {
                "data_source": "events",
                "name": "ev",
                "search": {
                  "query": "logpipe_incident:*"
                },
                "compute": {
                  "aggregation": "count"
                }
              }
            ],
            "formulas": [
              {
                "formula": "ev"
              }
            ]
          }
        ]
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Enrich backlog (PENDING rows)",
        "requests": [
          {
            "q": "avg:logpipe.enrich.backlog{*}",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "type": "log_stream",
        "title": "Anomaly logs",
        "query": "service:logpipe @is_anomaly:true",
        "columns": [
          "host",
          "service"
        ],
        "indexes": [],
        "message_display": "expanded-md",
        "show_date_column": true,
        "show_message_column": true,
        "sort": {
          "column": "time",
          "order": "desc"
        }
      }
    }
  ]
}
