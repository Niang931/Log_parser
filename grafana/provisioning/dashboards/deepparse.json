{
  "title": "DeepParse v2 \u2014 Silicon-Fab Log Intelligence",
  "uid": "deepparse-main",
  "tags": [
    "deepparse",
    "fab",
    "llm"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "10s",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Total Runs",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": 0
              }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "count_over_time({app=\"deepparse\", event_type=\"run_complete\"}[6h])"
        }
      ]
    },
    {
      "id": 2,
      "title": "LLM Fallback Calls",
