CLICKHOUSE_USER=logpipe
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DB=logpipe
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
# ClickHouse retention, applied when the tables are created (logpipe/storage/schema.sql).
# TTLs count from the event timestamp: replaying logs older than LOG_TTL_DAYS stores nothing.
RAW_TTL_DAYS=7
LOG_TTL_DAYS=30
ALERT_TTL_DAYS=90
# Rows still PENDING this long after ingest go to logs_dead_letter, then leave logs 1 h later.
PENDING_MAX_AGE_HOURS=24
# Nightly backup (scripts/backup.sh, docs/runbook-restore.md). A target with an empty
# BUCKET is skipped; both empty = make backup fails. Never commit real keys.
BACKUP_B2_ENDPOINT=https://s3.<region>.backblazeb2.com
BACKUP_B2_BUCKET=
BACKUP_B2_KEY_ID=
BACKUP_B2_SECRET=
BACKUP_S3_ENDPOINT=https://s3.<region>.amazonaws.com
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
# Folder inside the bucket, e.g. test/ for a test run; empty in production.
BACKUP_PREFIX=
# clickhouse-client port used by backup and restore (the app uses CLICKHOUSE_PORT, HTTP)
CLICKHOUSE_NATIVE_PORT=9000
# TODO:(Task 5.1) thêm MONGO_URI=mongodb://127.0.0.1:27017, MONGO_DB=logpipe; sửa comment STORE: memory | clickhouse | mongo
LOGS_PATH=logs
REGISTRY_PATH=artifacts/registry.json
LLM_BACKEND=offline
# Browser for LLM_BACKEND=llm:web:<site>: camoufox | chromium (the one on PATH)
WEB_BROWSER=camoufox
# Unresolved queue: memory (one process) | kafka (several `logpipe worker` processes)
QUEUE=memory
KAFKA_BOOTSTRAP=127.0.0.1:9092
KAFKA_TOPIC=logpipe.unresolved
KAFKA_GROUP=logpipe-workers
# Partition key: shape (lines of one candidate template together) | device
KAFKA_KEY_BY=shape
