CLICKHOUSE_USER=logpipe
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DB=logpipe
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
LOGS_PATH=logs
REGISTRY_PATH=artifacts/registry.json
LLM_BACKEND=offline
# Browser for LLM_BACKEND=llm:web:<site>: camoufox | chromium (the one on PATH)
WEB_BROWSER=camoufox
# Unresolved queue: memory (one process) | kafka (several `logpipe worker` processes)
QUEUE=memory
KAFKA_BOOTSTRAP=127.0.0.1:9092
KAFKA_TOPIC=logpipe.unresolved
KAFKA_GROUP=logpipe-workers
# Partition key: shape (lines of one candidate template together) | device
KAFKA_KEY_BY=shape

# UI admin password (`logpipe server`); unset = generated and printed on first start
# LOGPIPE_ADMIN_PASSWORD=

# MongoDB (docker compose --profile mongo | platform-mongo): auth is on, users are created on the first
# start only (`down -v` to redo). The URIs are for `logpipe server --store mongodb` on the host; keep the
# passwords in step with the ones below.
MONGO_URI=mongodb://logpipe:change-me@127.0.0.1:27017/?authSource=logpipe
MONGO_READONLY_URI=mongodb://logpipe_ro:change-me@127.0.0.1:27017/?authSource=logpipe
MONGO_ROOT_PASSWORD=change-me
MONGO_APP_PASSWORD=change-me
MONGO_RO_PASSWORD=change-me

# Datadog (optional; docs/guides/datadog.md). Self-monitoring is off unless --datadog is passed.
# Agent: docker compose --profile datadog up -d datadog-agent
# DD_LLMOBS_ENABLED=1           # trace LLM adapter calls (needs the Agent's trace port 8126)
# DD_APM=1                      # APM spans: requests, Mongo, ClickHouse, HTTP calls (Service Map)
# DD_API_KEY=                   # read by the Agent container only
# DD_SITE=datadoghq.com         # your Datadog region, e.g. datadoghq.eu, us5.datadoghq.com
# DD_AGENT_HOST=127.0.0.1       # `datadog-agent` if the pipeline itself runs in compose
# DD_LOG_FILE=.logpipe/dd-logs.jsonl
# DD_MONGO_PASSWORD=change-me   # MongoDB check: ./docker/datadog/mongo-user.sh creates the `datadog` user
# DD_APP_KEY=                   # logs search and pipelines (`logpipe server --datadog-pull`, Export to Datadog)
# DD_PULL_QUERY=service:shop*   # same as --datadog-pull
# DD_PULL_EVERY_S=15
# DD_PUBLIC_URL=https://...     # where links in Datadog events point (e.g. your tunnel to `logpipe server`)
