# Production environment for deploy/docker-compose.prod.yml.
#
# The whole file (minus IMAGE_PREFIX / IMAGE_TAG, which the workflow appends) is
# stored as the `PROD_ENV_FILE` secret on the GitHub `production` environment and
# written to /opt/logpipe-landing/.env on every deploy. Edit the secret, not the
# file on the server: the next rollout overwrites it.

# The public hostname Traefik routes to the landing page. DNS must point here
# for Traefik to get a certificate.
SITE_DOMAIN=logpipe.example.com

# Traefik's Docker network, created by the Ansible playbook.
TRAEFIK_NETWORK=traefik
